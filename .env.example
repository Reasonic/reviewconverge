# ReviewConverge API keys — copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#   # then edit .env  (it is git-ignored; never commit real keys)
#
# Keys are read by reviewconverge.config.load_dotenv() at repo root, and also
# honored directly from the environment (real env vars take precedence).
# You only need the key(s) for the provider(s) you actually run.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
