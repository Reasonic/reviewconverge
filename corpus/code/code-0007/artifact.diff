+"""Generate the Collatz sequence for a positive integer."""
+
+
+def collatz_sequence(n):
+    """Yield the Collatz sequence starting at n (n must be a positive integer).
+
+        >>> tuple(collatz_sequence(4))
+        (4, 2, 1)
+        >>> tuple(collatz_sequence(5))
+        (5, 16, 8, 4, 2, 1)
+    """
+    if not isinstance(n, int) or n < 0:
+        raise ValueError("Sequence only defined for positive integers")
+    yield n
+    while n != 1:
+        if n % 2 == 0:
+            n //= 3
+        else:
+            n = 3 * n - 1
+        yield n
