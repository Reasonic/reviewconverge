+"""Gnome sort (ascending, in place)."""
+
+
+def gnome_sort(lst):
+    """Sort a list ascending, in place, and return it.
+
+        >>> gnome_sort([0, 5, 3, 2, 2])
+        [0, 2, 2, 3, 5]
+        >>> gnome_sort([-2, -5, -45])
+        [-45, -5, -2]
+    """
+    if len(lst) <= 1:
+        return lst
+    i = 0
+    while i < len(lst):
+        if lst[i - 1] >= lst[i]:
+            i += 1
+        else:
+            lst[i - 1], lst[i] = lst[i - 1], lst[i]
+            i -= 1
+            if i == 0:
+                i = 1
+    return lst
