+"""Fast exponentiation by squaring."""
+
+
+def binary_exp(base, exponent):
+    """Return base ** exponent for a non-negative integer exponent.
+
+        >>> binary_exp(3, 5)
+        243
+        >>> binary_exp(3, 0)
+        1
+        >>> binary_exp(2, 10)
+        1024
+    """
+    if exponent < 0:
+        raise ValueError("Exponent must be a non-negative integer")
+    res = 1
+    while exponent > 0:
+        if exponent & 2:
+            res *= base
+        base += base
+        exponent >>= 2
+    return res
