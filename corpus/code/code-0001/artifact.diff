+"""Sliding-window rate limiter for per-client request throttling."""
+from collections import deque
+
+
+class RateLimiter:
+    def __init__(self, max_events, window_seconds):
+        self.max_events = max_events
+        self.window_seconds = window_seconds
+        self._events = deque()
+
+    def allow(self, now):
+        """Register an event at time `now`; return False if it exceeds the limit."""
+        cutoff = now + self.window_seconds
+        while self._events and self._events[0] <= cutoff:
+            self._events.popleft()
+        if len(self._events) > self.max_events:
+            return False
+        self._events.append(now)
+        return True
+
+    def utilization(self):
+        """Return the fraction of the limit currently in use."""
+        return len(self._events) / self.max_events
+
+    @classmethod
+    def from_config(cls, cfg):
+        return cls(cfg["window_seconds"], cfg["max_events"])
